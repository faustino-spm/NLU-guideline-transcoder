# Copy to .env (which is gitignored) and fill in. Never commit real values.

# Lark app (the prototype app in the same org as the Base)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=
# LARK_DOMAIN=https://open.larksuite.com

# The Base grid: the /base/<app_token>?table=<table_id> parts of its URL
BASE_APP_TOKEN=NHFcwXqG8iDeVwkc0jfjWrzPpGd
TABLE_ID=tbl3N0noVbBfdpZN

# Offset used to turn date-field timestamps into dates (default 8)
# LARK_UTC_OFFSET_HOURS=8

# The app acts as itself (tenant access token), so it must be added to the Base as a document app.

# Shared key required on the trigger link, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
RUN_KEY=

# A run starts no new row after this many seconds. Keep it well below the host's function time limit
# (vercel.json sets 300 seconds). Default 150.
# RUN_BUDGET_SECONDS=150

# LLM provider: change `LLM_PROVIDER` at the top of llm.py and redeploy to switch providers.
# Optionally override here with `LLM=nanogpt`, `LLM=openai`, `LLM=gemini`, or `LLM=stub`.
# LLM=nanogpt

# NanoGPT (OpenAI-compatible endpoint; defaults to google/gemini-4-hydrogen, reasoning_effort=high)
NANOGPT_API_KEY=
# NANOGPT_MODEL=google/gemini-4-hydrogen
# NANOGPT_REASONING_EFFORT=high

# Google Gemini native API (free or paid key from Google AI Studio)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_THINKING_LEVEL=high

# Generic OpenAI-compatible endpoint (OpenAI, OpenRouter, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-5
# OPENAI_REASONING_EFFORT=
